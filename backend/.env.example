# Copy to backend/.env for running the API directly on your host (outside
# Docker), e.g. `uvicorn app.main:app --reload`.
#
# When running via `docker-compose up`, this file is NOT used — the backend
# container gets its environment from the project ROOT .env file instead
# (see docker-compose.yml's `environment:` block and the root .env.example).

PROJECT_NAME=ShortLink
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
DEBUG=true
BASE_URL=http://localhost:8000

# --- PostgreSQL ---
# On a managed platform (Render, etc.) that gives you a single connection
# string instead, set DATABASE_URL directly and leave the fields below at
# their defaults — DATABASE_URL always takes priority when set. See
# docs/DEPLOYMENT.md.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=shortlink
POSTGRES_PASSWORD=shortlink
POSTGRES_DB=shortlink

# --- Redis ---
# Same as DATABASE_URL above — set REDIS_URL directly on managed platforms.
# REDIS_URL=redis://host:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- JWT auth (Phase 2) ---
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- CORS ---
BACKEND_CORS_ORIGINS=http://localhost:5173

# --- Short URL generation & redirects (Phase 3) ---
SHORT_CODE_LENGTH=7
CUSTOM_ALIAS_MIN_LENGTH=3
CUSTOM_ALIAS_MAX_LENGTH=32
URL_CACHE_TTL_SECONDS=300

# --- Rate limiting (Phase 6, Redis-backed) ---
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=5

LOG_LEVEL=INFO
