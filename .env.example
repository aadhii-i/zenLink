# Copy to .env at the project root, then run: docker-compose up --build
#
# This is the ONLY .env file docker-compose.yml reads. It fills in both
# docker-compose.yml's own variable substitutions (e.g. the `db`/`redis`
# service credentials) and the values passed into the backend/frontend
# containers' `environment:` blocks. backend/.env.example and
# frontend/.env.example are separate files for running those services
# directly on your host, without Docker.

# --- General ---
PROJECT_NAME=ShortLink
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
DEBUG=true
BASE_URL=http://localhost:8000

# --- PostgreSQL ---
POSTGRES_USER=shortlink
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shortlink
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- JWT auth (Phase 2) ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- CORS ---
# Comma-separated list of allowed frontend origins.
BACKEND_CORS_ORIGINS=http://localhost:5173

# --- Short URL generation & redirects (Phase 3) ---
SHORT_CODE_LENGTH=7
CUSTOM_ALIAS_MIN_LENGTH=3
CUSTOM_ALIAS_MAX_LENGTH=32
URL_CACHE_TTL_SECONDS=300

# --- Rate limiting (Phase 6, Redis-backed) ---
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=5

LOG_LEVEL=INFO

# --- Frontend ---
VITE_API_URL=http://localhost:8000/api/v1
